            {
              "attributes": {
                "artistName": "Radiohead",
                "artwork": {
                  "bgColor": "0a0a08",
                  "hasP3": false,
                  "height": 4000,
                  "textColor1": "e2eaee",
                  "textColor2": "d3d2d1",
                  "textColor3": "b7bdc0",
                  "textColor4": "abaaa8",
                  "url": "https://is1-ssl.mzstatic.com/image/thumb/Music122/v4/bd/8e/13/bd8e1358-b367-a689-cb84-cebd0b067dc4/634904078263.png/{w}x{h}bb.jpg",
                  "width": 4000
