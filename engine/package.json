{
  "name": "ringomusic-engine",
  "version": "1.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "gen:protocol": "node gen-protocol.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
